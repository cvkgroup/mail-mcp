{
  "name": "agent-mail",
  "version": "1.0.0",
  "description": "MCP server for inter-agent mail routing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "sandbox": "bash scripts/safe-shell.sh",
    "verify-sandbox": "bash scripts/verify-sandbox.sh",
    "seat-session": "bash scripts/seat-session.sh",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "pipeline": "tsx pipeline/pipeline.ts",
    "pipeline:check": "tsc -p pipeline/tsconfig.json",
    "pipeline:test": "vitest run pipeline/",
    "pipeline:providers": "tsx pipeline/provider-report.ts"
  },
  "keywords": [
    "mcp",
    "mail",
    "agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
