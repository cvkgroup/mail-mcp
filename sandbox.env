# Throwaway sandbox: stub wake transport + temp mailbox
export SANDBOX=$(mktemp -d)
mkdir -p "$SANDBOX/bin"
printf '#!/bin/sh\necho "[stub wake] $*" >> '"$SANDBOX"'/wakes.log\ncat > /dev/null\n' > "$SANDBOX/bin/prime-agent"
chmod +x "$SANDBOX/bin/prime-agent"
export PATH="$SANDBOX/bin:$PATH"
export AGENT_MAIL_BASE_DIR="$SANDBOX/mail"
export AGENT_MAIL_BOOTSTRAP='[{"id":"lead","role":"lead","lane":"hq"}]'
echo "sandbox: $SANDBOX"
